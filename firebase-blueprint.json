{
  "entities": {
    "Subject": {
      "title": "Subject",
      "description": "PCI-aligned B.Pharm academic subject for Semesters 1 to 8.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "PCI subject code (e.g. BP101T)"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Subject title"
        },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Clean URL slug for routing"
        },
        "semester": {
          "type": "number",
          "description": "Semester number from 1 to 8"
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Branch category (Pharmacology, Pharmaceutics, Medicinal Chemistry, Analysis, Pharmacognosy)"
        },
        "summary": {
          "type": "string",
          "maxLength": 500,
          "description": "Student-friendly subject overview"
        },
        "unitsCount": {
          "type": "number",
          "description": "Number of syllabus units (typically 5)"
        },
        "trending": {
          "type": "boolean",
          "description": "Whether subject is trending during exams"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "title", "slug", "semester", "category", "summary", "unitsCount", "trending", "createdAt"]
    },
    "ResourceItem": {
      "title": "ResourceItem",
      "description": "Study material PDF item (Notes, Syllabus, PYQs, Important Questions, Short Notes).",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "subjectSlug": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "subjectCode": {
          "type": "string",
          "maxLength": 20
        },
        "subjectTitle": {
          "type": "string",
          "maxLength": 140
        },
        "semester": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["notes", "syllabus", "pyqs", "important-questions", "short-notes"]
        },
        "unitNumber": {
          "type": "number"
        },
        "university": {
          "type": "string",
          "maxLength": 80,
          "description": "PCI Standard, AKTU, RGPV, MUHS, JNTU, or GTU"
        },
        "pages": {
          "type": "number"
        },
        "fileSize": {
          "type": "string",
          "maxLength": 30
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "previewContent": {
          "type": "string",
          "maxLength": 4000,
          "description": "Structured clinical/study preview content for the interactive PDF viewer and generator"
        },
        "pdfDataUrl": {
          "type": "string",
          "maxLength": 900000,
          "description": "Uploaded PDF file (Data URL or direct PDF URL) for real PDF viewing and downloading"
        },
        "featured": {
          "type": "boolean"
        },
        "downloads": {
          "type": "number"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "subjectSlug",
        "subjectCode",
        "subjectTitle",
        "semester",
        "type",
        "unitNumber",
        "university",
        "pages",
        "fileSize",
        "summary",
        "previewContent",
        "featured",
        "downloads",
        "authorUid",
        "createdAt"
      ]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Exam alerts, GPAT/NIPER strategies, and pharmacy career articles.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 180
        },
        "slug": {
          "type": "string",
          "maxLength": 140,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "readTime": {
          "type": "string",
          "maxLength": 30
        },
        "publishedDate": {
          "type": "string",
          "maxLength": 40
        },
        "excerpt": {
          "type": "string",
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 8000
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 300
        },
        "authorName": {
          "type": "string",
          "maxLength": 80
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "slug",
        "category",
        "readTime",
        "publishedDate",
        "excerpt",
        "content",
        "imageUrl",
        "authorName",
        "authorUid",
        "createdAt"
      ]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "Student's saved bookmark for a study resource.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "resourceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "resourceTitle": {
          "type": "string",
          "maxLength": 180
        },
        "subjectSlug": {
          "type": "string",
          "maxLength": 120
        },
        "semester": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "resourceId", "resourceTitle", "subjectSlug", "semester", "type", "createdAt"]
    }
  },
  "firestore": {
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Public read-only B.Pharm subjects across Sem 1-8; writable by verified admins."
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/ResourceItem" },
      "description": "Public read-only B.Pharm notes, PYQs, syllabus, and guess papers; writable by verified admins."
    },
    "/resources/{resourceId}/pdfChunks/{chunkId}": {
      "schema": "PdfChunk",
      "description": "Base64 chunks for large uploaded PDF files exceeding 650 KB."
    },
    "/blogs/{blogId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Public read-only pharmacy news, GPAT/NIPER updates, and career guides; writable by verified admins."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Private student bookmarks isolated per user UID."
    },
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Trusted admin lookup collection."
    }
  }
}
